# Files NOT to send to the Docker context. The runner image
# rebuilds node_modules and dist/ from the manifest + source, so
# we don't pay the upload cost for either.

# Local install artifacts
node_modules
**/node_modules
.pnp
.pnp.js

# Local build output
dist
build
coverage
**/coverage

# Git + IDE
.git
.gitignore
.gitattributes
.vscode
.idea

# Test artifacts
**/*.log
**/.DS_Store
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# CI configuration
.github

# Local-only files
.eslintcache
.prettierrc
commit-msg*.txt
