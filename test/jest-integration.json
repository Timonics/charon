{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["**/*.integration-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!dinero\\.js|node-pg-migrate)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000
}
